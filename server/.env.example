# Postgres connection string for the self-hosted `ghlprime` database on the VPS.
# Example: postgres://ghlprime_app:CHANGE_ME@127.0.0.1:5432/ghlprime
DATABASE_URL=postgres://user:password@127.0.0.1:5432/ghlprime

# Set to "true" only if the Postgres server requires/accepts SSL connections
# (most self-hosted single-VPS setups leave this off since the DB is local).
DATABASE_SSL=false

# Secret used to sign/verify admin JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# AES-256-GCM key used to encrypt the Claude Code OAuth tokens admins paste
# into the Auto Blog settings UI (server/src/utils/tokenCrypto.js). Must
# decode to exactly 32 raw bytes, hex-encoded here. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-64-char-hex-string

# Port the Express API listens on. Chosen outside the ranges already used by
# this VPS's other Node apps (3000-3100, 4000-4100, 5000-5101, 6001-6002,
# 8090-8091).
PORT=5013

# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:5173,https://dev.ghlprime.com,https://ghlprime.com

# Optional: absolute path to the directory admin-uploaded images are written
# to and served from (mounted at GET /uploads/<file>). Defaults to
# "<server working dir>/uploads" when unset. Keep this OUTSIDE the frontend's
# dist/ folder — dist/ is wiped and fully replaced on every site
# rebuild/deploy, so anything stored there would be destroyed on the next
# deploy.
UPLOAD_DIR=
